generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// NOTE: Pour le développement local, utiliser DATABASE_URL avec une connexion PostgreSQL locale
// ou Neon (https://neon.tech). Le fichier .env.local permet de surcharger .env.

// ─── AUTH ────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  hashedPassword String?
  image          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  properties      Property[]
  tenants         Tenant[]
  investments     Investment[]
  notifications   Notification[]
  documents       Document[]
  works           Work[]
  expenses        Expense[]
  accounts        Account[]
  sessions        Session[]
  enabledModules  UserModule[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── USER MODULES (feature flags per user) ──────────

model UserModule {
  id        String   @id @default(cuid())
  userId    String
  module    String   // EXPENSES | WORKS | UTILITIES | LEGAL | ADVANCED_DOCS
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
}

// ─── REAL ESTATE ────────────────────────────────────

model Property {
  id               String   @id @default(cuid())
  userId           String
  name             String
  type             String?  // APARTMENT | HOUSE | BUILDING (optional now)
  address          String
  city             String?
  postalCode       String?
  country          String   @default("France")
  ownershipType    String   @default("personal") // personal | sci
  acquisitionDate  String?
  acquisitionPrice Float?
  currentValue     Float?
  surface          Float?
  description      String?
  imageUrl         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  lots             Lot[]
  documents        Document[]
  works            Work[]
  expenses         Expense[]
  complianceItems  ComplianceItem[]

  @@index([userId])
}

model Lot {
  id          String   @id @default(cuid())
  propertyId  String
  label       String
  status      String   @default("VACANT") // VACANT | OCCUPIED
  surface     Float?
  rooms       Int?
  floor       Int?
  description String?
  monthlyRent Float?   // Quick rent amount (before lease)
  rentDueDay  Int?     // Day of month rent is due
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases          Lease[]
  documents       Document[]
  works           Work[]
  expenses        Expense[]
  utilities       Utility[]
  complianceItems ComplianceItem[]

  @@index([propertyId])
}

model Tenant {
  id        String   @id @default(cuid())
  userId    String
  firstName String
  lastName  String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  leases Lease[]

  @@index([userId])
}

model Lease {
  id                String   @id @default(cuid())
  lotId             String
  tenantId          String
  startDate         String
  endDate           String?
  monthlyRent       Float
  charges           Float    @default(0)
  deposit           Float?
  depositReceived   Boolean  @default(false)
  paymentDayOfMonth Int      @default(1)
  isActive          Boolean  @default(true)
  notifyDaysBefore  Int      @default(3)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lot        Lot         @relation(fields: [lotId], references: [id], onDelete: Cascade)
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  rentEvents RentEvent[]

  @@index([lotId])
  @@index([tenantId])
}

model RentEvent {
  id         String   @id @default(cuid())
  leaseId    String
  dueDate    String
  amount     Float
  paidAmount Float    @default(0)
  status     String   @default("PENDING") // PENDING | DUE | PAID | LATE | PARTIALLY_PAID
  paidDate   String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@unique([leaseId, dueDate])
  @@index([status])
  @@index([dueDate])
}

// ─── DOCUMENTS ──────────────────────────────────────

model Document {
  id          String   @id @default(cuid())
  userId      String
  propertyId  String?
  lotId       String?
  name        String
  category    String   @default("OTHER") // LEASE_CONTRACT | INSURANCE | TAX | INVOICE | PHOTO | DIAGNOSTIC | RECEIPT | OTHER
  fileUrl     String
  fileType    String
  fileSize    Int
  description String?
  tags        String?
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])
  lot      Lot?      @relation(fields: [lotId], references: [id])

  @@index([userId])
  @@index([propertyId])
  @@index([category])
}

// ─── WORKS ──────────────────────────────────────────

model Work {
  id              String   @id @default(cuid())
  userId          String
  propertyId      String?
  lotId           String?
  title           String
  description     String?
  contractor      String?
  cost            Float?
  status          String   @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | CANCELLED
  startDate       String?
  endDate         String?
  isTaxDeductible Boolean  @default(false)
  taxCategory     String?
  invoiceUrl      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])
  lot      Lot?      @relation(fields: [lotId], references: [id])

  @@index([userId])
  @@index([propertyId])
}

// ─── EXPENSES & CHARGES ─────────────────────────────

model Expense {
  id          String   @id @default(cuid())
  userId      String
  propertyId  String?
  lotId       String?
  title       String
  amount      Float
  category    String   @default("OTHER") // INSURANCE | TAX | MAINTENANCE | MANAGEMENT | CONDO_FEES | LOAN | UTILITY | OTHER
  isRecurring Boolean  @default(false)
  frequency   String?  // MONTHLY | QUARTERLY | YEARLY
  date        String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])
  lot      Lot?      @relation(fields: [lotId], references: [id])

  @@index([userId])
  @@index([propertyId])
  @@index([category])
}

// ─── UTILITIES (water, electricity) ─────────────────

model Utility {
  id          String   @id @default(cuid())
  lotId       String
  type        String   // WATER | ELECTRICITY | GAS | OTHER
  period      String   // YYYY-MM format
  consumption Float?
  cost        Float?
  unit        String?  // m3, kWh, etc.
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([lotId, type, period])
  @@index([lotId])
}

// ─── LEGAL & COMPLIANCE ─────────────────────────────

model ComplianceItem {
  id          String   @id @default(cuid())
  propertyId  String?
  lotId       String?
  type        String   // LEASE_SIGNED | DEPOSIT_RECEIVED | TENANT_INSURANCE | DPE | GAS_DIAGNOSTIC | ELECTRICAL_DIAGNOSTIC | LEAD_DIAGNOSTIC | SMOKE_DETECTOR | CUSTOM
  label       String
  status      String   @default("MISSING") // OK | MISSING | EXPIRED | EXPIRING_SOON
  date        String?  // Date of completion/receipt
  expiryDate  String?  // When it expires
  notes       String?
  documentUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lot      Lot?      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([lotId])
}

// ─── INVESTMENTS ────────────────────────────────────

model Investment {
  id           String   @id @default(cuid())
  userId       String
  name         String
  assetType    String   // STOCK | ETF | BOND | CRYPTO | FUND | SAVINGS_ACCOUNT | LIFE_INSURANCE | OTHER
  ticker       String?
  quantity     Float?
  buyPrice     Float
  currentPrice Float?
  currency     String   @default("EUR")
  broker       String?
  accountName  String?
  purchaseDate String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([assetType])
}

// ─── NOTIFICATIONS ──────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // RENT_REMINDER | RENT_LATE | LEASE_EXPIRING | WORK_COMPLETED | COMPLIANCE_EXPIRING | GENERAL
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
}
